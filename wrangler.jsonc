{
  "name": "relic-isle",
  "main": "shootout/src/server/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
