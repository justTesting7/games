{
  "name": "jev-football",
  "version": "1.0.0",
  "private": true,
  "description": "A photoreal stadium football match in the browser, against a Jev-coached side",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "test": "node scripts/test-ball.mjs && node scripts/test-match.mjs && node scripts/test-brain.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}
