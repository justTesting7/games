{
  "name": "jev-football",
  "main": "src/server/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    { "binding": "SHOOTER", "service": "relic-isle" }
  ]
}
